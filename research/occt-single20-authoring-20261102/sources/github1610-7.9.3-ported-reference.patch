+  const double aLow[4]  = {UFirst1, VFirst1, UFirst2, VFirst2};
+  const double aHigh[4] = {ULast1, VLast1, ULast2, VLast2};
+  const double aReso[4] = {ResoU1, ResoV1, ResoU2, ResoV2};
+
+  // Bit i is set when parameter i lies within its resolution of the lower bound,
+  // bit i + 4 when it lies within its resolution of the upper bound.
+  auto aBoundMask = [&](const double theParam[4]) {
+    int aMask = 0;
+    for (int i = 0; i < 4; ++i)
+    {
+      if (theParam[i] - aLow[i] < aReso[i])
+      {
+        aMask |= (1 << i);
+      }
+      if (theParam[i] - aHigh[i] > -aReso[i])
+      {
+        aMask |= (1 << (i + 4));
+      }
+    }
+    return aMask;
+  };
+
+  // A line that merely ends on a parametric bound must still be extended: the
+  // extension is what bridges two half curves that stop short of a shared crest.
+  // Only a line that runs along the bound has nothing left to extend.
