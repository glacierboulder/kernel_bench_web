new file mode 100644
index 0000000000..4d15b34ad8
--- /dev/null
+++ b/tests/bugs/modalg_5/bug25337_1
@@ -0,0 +1,33 @@
+puts "================"
+puts "OCC25337"
+puts "================"
+puts ""
+####################################
+# Regression to version 6.7.1 : boolean operations fail on two planar circular faces lying in the same plane
+####################################
+
+circle c1 -50 0 0 10
+circle c2 -35 0 0 10
+mkedge e1 c1
+mkedge e2 c2
+wire w1 e1
+wire w2 e2
+mkplane f1 w1
+mkplane f2 w2
+
+bop f1 f2
+bopfuse result
+
+set square 582.987
+
+set nb_v_good 4
+set nb_e_good 6
+set nb_w_good 3
+set nb_f_good 3
+set nb_sh_good 1
+set nb_sol_good 0
+set nb_compsol_good 0
+set nb_compound_good 1
+set nb_shape_good 18
+
+set 2dviewer 1
