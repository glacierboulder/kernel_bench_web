   myBuilder.Compute();
   if (myBuilder.IsDone())
   {
+    // Fail safely when generated vertex tolerances are comparable to
+    // the distance between distinct endpoints.
+    const TopoDS_Shape& aResult = myBuilder.Shape();
+    for (TopExp_Explorer anEdge(aResult, TopAbs_EDGE); anEdge.More(); anEdge.Next())
+    {
+      const TopoDS_Edge anE = TopoDS::Edge(anEdge.Current());
+      if (BRep_Tool::Degenerated(anE))
+        continue;
+      const TopoDS_Vertex aFirst = TopExp::FirstVertex(anE);
+      const TopoDS_Vertex aLast  = TopExp::LastVertex(anE);
+      if (aFirst.IsNull() || aLast.IsNull() || aFirst.IsSame(aLast))
+        continue;
+      const double aSpan = BRep_Tool::Pnt(aFirst).Distance(BRep_Tool::Pnt(aLast));
+      const double aTolerance = BRep_Tool::Tolerance(aFirst) + BRep_Tool::Tolerance(aLast);
+      if (aSpan > Precision::Confusion() && aTolerance >= aSpan)
+      {
+        NotDone();
+        return;
+      }
+    }
     Done();
-    myShape = myBuilder.Shape();
+    myShape = aResult;
 
     // creation of the Map.
     TopExp_Explorer ex;
