# Inline this helper into every DRAW case that is frozen as a checkpoint.
# Frozen evaluation copies the checkpoint case itself, not sibling helper files.
namespace eval ::bench {
  variable assertions 0
  variable numeric_assertions 0
  variable failures 0
}

proc ::bench::_record {kind passed label detail} {
  variable assertions
  variable numeric_assertions
  variable failures
  incr assertions
  if {$kind eq "numeric"} { incr numeric_assertions }
  if {$passed} {
    puts "BENCH_ASSERT_PASS kind=$kind label=[list $label] detail=[list $detail]"
  } else {
    incr failures
    puts stderr "BENCH_ASSERT_FAIL kind=$kind label=[list $label] detail=[list $detail]"
  }
  return [expr {$passed ? 1 : 0}]
}

proc bench_assert {expression label} {
  if {[catch {uplevel 1 [list expr $expression]} value]} {
    return [::bench::_record expression 0 $label "evaluation_error=$value"]
  }
  return [::bench::_record expression [expr {$value ? 1 : 0}] $label "value=$value"]
}

proc bench_assert_close {actual expected tolerance label} {
  foreach value [list $actual $expected $tolerance] {
    if {![string is double -strict $value] ||
        [catch {expr {abs(double($value)) <= 1.7976931348623157e308}} finite] ||
        !$finite} {
      return [::bench::_record numeric 0 $label \
        "actual=$actual expected=$expected tolerance=$tolerance non_finite_or_non_numeric"]
    }
  }
  if {[catch {expr {double($tolerance) >= 0.0}} valid_tolerance] || !$valid_tolerance} {
    return [::bench::_record numeric 0 $label \
      "actual=$actual expected=$expected tolerance=$tolerance invalid_tolerance"]
  }
  set error [expr {abs(double($actual) - double($expected))}]
  set passed [expr {$error <= double($tolerance)}]
  return [::bench::_record numeric $passed $label \
    "actual=$actual expected=$expected tolerance=$tolerance absolute_error=$error"]
}

proc bench_assert_range {actual lower upper label} {
  foreach value [list $actual $lower $upper] {
    if {![string is double -strict $value] ||
        [catch {expr {abs(double($value)) <= 1.7976931348623157e308}} finite] ||
        !$finite} {
      return [::bench::_record numeric 0 $label \
        "actual=$actual lower=$lower upper=$upper non_finite_or_non_numeric"]
    }
  }
  set passed [expr {double($lower) <= double($actual) && double($actual) <= double($upper)}]
  return [::bench::_record numeric $passed $label \
    "actual=$actual lower=$lower upper=$upper"]
}

proc bench_finish {} {
  variable ::bench::assertions
  variable ::bench::numeric_assertions
  variable ::bench::failures
  if {$assertions < 1} {
    return -code error "bench_finish requires at least one assertion"
  }
  if {$failures != 0} {
    puts stderr "BENCH_ORACLE_FAILED assertions=$assertions failures=$failures"
    return -code error "one or more benchmark assertions failed"
  }
  puts "BENCH_ORACLE_OK assertions=$assertions numeric_assertions=$numeric_assertions"
  puts "TEST_DONE assertions=$assertions numeric_assertions=$numeric_assertions"
}
proc bench_restore_b64 {encoded shape key} {
 set scratch [pwd]
 if {[info exists ::env(TMPDIR)] && $::env(TMPDIR) ne ""} {set scratch $::env(TMPDIR)}
 set path [file join $scratch [format ".occt_%s_%d.brep" $key [pid]]]
 set f [open $path wb]; fconfigure $f -translation binary -encoding binary
 puts -nonewline $f [binary decode base64 $encoded]; close $f
 uplevel #0 [list restore $path $shape]; file delete -force $path
}
proc bench_count_curves {root} {
 set description [uplevel #0 [list whatis $root]]
 if {[string first "3d curve" $description] >= 0} {uplevel #0 [list renamevar $root ${root}_1]}
 set n 0
 for {set __bench_curve_scan_idx 1} {$__bench_curve_scan_idx <= 128} {incr __bench_curve_scan_idx} {
  set description [uplevel #0 [list whatis ${root}_${__bench_curve_scan_idx}]]
  if {[string first "3d curve" $description] < 0} {break}
  incr n
 }
 return $n
}
proc bench_count_subshapes {shape kind} {return [llength [uplevel #0 [list explode $shape $kind]]]}
proc bench_valid {shape label} {
 set audit [uplevel #0 [list bopcheck $shape]]
 bench_assert {[regexp -nocase {OK} $audit]} "$label BOP validity"
 set report [uplevel #0 [list checkshape $shape]]
 bench_assert {[regexp -nocase {valid} $report] && ![regexp -nocase {faulty|invalid} $report]} "$label shape validity"
}
proc bench_nb {shape options label} {
 set report [uplevel #0 [list nbshapes $shape]]
 foreach {option expected} $options {
  set kind [string toupper [string range $option 1 end]]
  set pattern [format {%s +: +([0-9]+)} $kind]
  if {![regexp -nocase $pattern $report full actual]} {
   bench_assert {0} "$label $kind count is present"
  } else {
   bench_assert {$actual == $expected} "$label $kind count"
  }
 }
}
proc bench_props {shape label options} {
 foreach {option expected} $options {
  switch -- $option {
   -l {set command lprops; set kind length}
   -s {set command sprops; set kind area}
   -v {set command vprops; set kind volume}
   default {bench_assert {0} "$label unsupported property option $option"; continue}
  }
  set report [uplevel #0 [list $command $shape 1.0e-6]]
  if {![regexp {Mass +: +([-0-9.+eE]+)} $report full actual]} {
   bench_assert {0} "$label $kind measurement is present"
  } else {
   set tolerance [expr {abs(double($expected)) * 0.001}]
   if {$tolerance < 1.0e-8} {set tolerance 1.0e-8}
   bench_assert_close $actual $expected $tolerance "$label $kind"
  }
 }
}
proc bench_tol {shape tol label} {
 set report [uplevel #0 [list tolerance $shape]]
 if {![regexp {Tolerance MAX=([-0-9.+eE]+)} $report full actual]} {
  bench_assert {0} "$label maximum tolerance is present"
 } else {
  bench_assert {$actual <= $tol} "$label maximum tolerance"
 }
}
proc bench_tol_ref {shape expected label} {
 set report [uplevel #0 [list tolerance $shape]]
 if {![regexp {Tolerance MAX=([-0-9.+eE]+)} $report full actual]} {
  bench_assert {0} "$label maximum tolerance is present"
 } else {
  set allowed [expr {1.0e-4 + abs(double($expected)) * 0.01}]
  bench_assert_close $actual $expected $allowed "$label maximum tolerance reference"
 }
}
