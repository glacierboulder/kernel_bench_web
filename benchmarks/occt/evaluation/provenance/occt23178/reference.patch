+//=======================================================================
+//function : Common
+//purpose  : 
+//=======================================================================
+void Bnd_Range::Common(const Bnd_Range& theOther)
+{
+  if(theOther.IsVoid())
+  {
+    SetVoid();
+  }
+
+  if(IsVoid())
+  {
+    return;
+  }
+
+  myFirst = Max(myFirst, theOther.myFirst);
+  myLast = Min(myLast, theOther.myLast);
+}
