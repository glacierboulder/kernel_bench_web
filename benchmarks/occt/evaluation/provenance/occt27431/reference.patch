 // It is pure empirical value.
 const Standard_Real IntPatch_WLineTool::myMaxConcatAngle = M_PI/6;
 
 //Bit-mask is used for information about 
 //the operation made in
-//IntPatch_WLineTool::ExtendTwoWlinesToEachOther() method.
