{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "kind", "source_id", "execution_mode", "members", "budget", "required_outputs", "evaluation_suite"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["single", "group", "active"]},
    "source_id": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["joint", "independent"]},
    "members": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["issue_id", "issue_version"], "properties": {"issue_id": {"type": "string"}, "issue_version": {"type": "string"}}, "additionalProperties": false}},
    "budget": {"type": "object", "required": ["scope", "wall_seconds"], "properties": {"scope": {"const": "group"}, "wall_seconds": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "required_outputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evaluation_suite": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "has_hidden_checks": {"type": "boolean"}
  },
  "additionalProperties": false
}
